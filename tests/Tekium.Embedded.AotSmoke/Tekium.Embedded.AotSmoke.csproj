<Project Sdk="Microsoft.NET.Sdk">

  <!-- Consumidor mínimo publicado con Native AOT: es la prueba de que el núcleo sigue siendo AOT-compatible. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Tekium.Embedded.AotSmoke</RootNamespace>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Tekium.Embedded.Core\Tekium.Embedded.Core.csproj" />
    <ProjectReference Include="..\..\src\Tekium.Embedded.Caching\Tekium.Embedded.Caching.csproj" />
    <ProjectReference Include="..\..\src\Tekium.Embedded.DataProtection\Tekium.Embedded.DataProtection.csproj" />
    <ProjectReference Include="..\..\src\Tekium.Embedded.HealthChecks\Tekium.Embedded.HealthChecks.csproj" />
    <ProjectReference Include="..\..\src\Tekium.Embedded.Linq\Tekium.Embedded.Linq.csproj" />
    <ProjectReference Include="..\..\src\Tekium.Embedded.Sql\Tekium.Embedded.Sql.csproj" />
    <ProjectReference Include="..\..\src\Tekium.Embedded.Vectors\Tekium.Embedded.Vectors.csproj" />
    <!-- El generador de código corre en el compilador: se referencia como analizador, no como ensamblado. -->
    <ProjectReference Include="..\..\src\Tekium.Embedded.Generators\Tekium.Embedded.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
