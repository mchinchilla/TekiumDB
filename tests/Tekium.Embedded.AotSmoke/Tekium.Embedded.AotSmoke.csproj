<Project Sdk="Microsoft.NET.Sdk">

  <!-- Consumidor mínimo publicado con Native AOT: es la prueba de que el núcleo sigue siendo AOT-compatible. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Tekium.Embedded.AotSmoke</RootNamespace>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Tekium.Embedded.Core\Tekium.Embedded.Core.csproj" />
  </ItemGroup>

</Project>
