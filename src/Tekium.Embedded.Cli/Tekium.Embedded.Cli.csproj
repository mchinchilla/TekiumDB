<Project Sdk="Microsoft.NET.Sdk">

  <!-- tkdb: inspección, reparación, compactación y cambio de contraseña desde la línea de comandos. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Tekium.Embedded.Cli</RootNamespace>
    <AssemblyName>tkdb</AssemblyName>
    <PackageId>Tekium.Embedded.Cli</PackageId>
    <Description>TekiumDB: herramienta de línea de comandos para inspeccionar, reparar y compactar archivos .tkdb.</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>tkdb</ToolCommandName>
    <!-- dotnet publish da un ejecutable nativo, sin runtime que instalar. -->
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tekium.Embedded.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tekium.Embedded.Core\Tekium.Embedded.Core.csproj" />
  </ItemGroup>

</Project>
