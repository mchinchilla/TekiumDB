<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>TekiumDB.EntityFrameworkCore</RootNamespace>
    <PackageId>TekiumDB.EntityFrameworkCore</PackageId>
    <Description>TekiumDB: Entity Framework Core provider, async only.</Description>
    <!-- EF Core construye sus consultas con reflexión y código generado en ejecución: este paquete, y sólo éste, no es compatible con Native AOT. -->
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TekiumDB.Core\TekiumDB.Core.csproj" PrivateAssets="none" />
    <ProjectReference Include="..\TekiumDB.Sql\TekiumDB.Sql.csproj" />
  </ItemGroup>

</Project>
