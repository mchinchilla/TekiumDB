<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>TekiumDB.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="CsCheck" />
    <PackageReference Include="Dapper" />
    <!-- Para ejecutar el generador de código dentro de una prueba y examinar lo que produce. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TekiumDB.Core\TekiumDB.Core.csproj" />
    <ProjectReference Include="..\..\src\TekiumDB.Caching\TekiumDB.Caching.csproj" />
    <ProjectReference Include="..\..\src\TekiumDB.DataProtection\TekiumDB.DataProtection.csproj" />
    <ProjectReference Include="..\..\src\TekiumDB.EntityFrameworkCore\TekiumDB.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\..\src\TekiumDB.HealthChecks\TekiumDB.HealthChecks.csproj" />
    <ProjectReference Include="..\..\src\TekiumDB.Linq\TekiumDB.Linq.csproj" />
    <ProjectReference Include="..\..\src\TekiumDB.Sql\TekiumDB.Sql.csproj" />
    <!-- La herramienta de línea de comandos se prueba llamando a su punto de entrada. -->
    <ProjectReference Include="..\..\src\TekiumDB.Cli\TekiumDB.Cli.csproj" />
    <!-- El generador de código corre en el compilador: se referencia como analizador, no como ensamblado. -->
    <ProjectReference Include="..\..\src\TekiumDB.Generators\TekiumDB.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true" />
    <!-- Las pruebas de crash lanzan este ejecutable y comparten con él la carga de trabajo. -->
    <ProjectReference Include="..\TekiumDB.CrashChild\TekiumDB.CrashChild.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
